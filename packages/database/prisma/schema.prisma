// Finora — shared Prisma schema.
// Contains Better Auth's own tables (user/session/account/verification/jwks)
// PLUS every Finora domain table. One schema, one migration history,
// used by both apps/client (Better Auth) and apps/server (NestJS).

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =========================================================================
// Better Auth core tables — field shapes must match what Better Auth's
// Prisma adapter expects. Do not remove/rename these scalar fields.
// =========================================================================

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions Session[]
  accounts Account[]

  settings              UserSettings?
  financialAccounts     FinancialAccount[]
  categories            Category[]
  tags                  Tag[]
  transactions          Transaction[]
  budgets               Budget[]
  savingGoals           SavingGoal[]
  savingGoalContributions SavingGoalContribution[]
  subscriptions         Subscription[]
  recurringTransactions RecurringTransaction[]
  notifications         Notification[]
  receipts              Receipt[]
  financialInsights     FinancialInsight[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@index([identifier])
  @@map("verification")
}

/// Public/private signing keys for Better Auth's JWT plugin (JWKS endpoint).
model Jwks {
  id         String    @id
  publicKey  String
  privateKey String
  createdAt  DateTime
  expiresAt  DateTime?
  alg        String?
  crv        String?

  @@map("jwks")
}

// =========================================================================
// Finora domain tables (spec §37)
// =========================================================================

/// Per-user preferences — spec §5 profile fields + §26 notification toggles.
model UserSettings {
  id       String @id @default(cuid())
  userId   String @unique
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  defaultCurrency String @default("BDT")
  language        String @default("en")
  timezone        String @default("Asia/Dhaka")
  dateFormat      String @default("DD MMM YYYY")

  notifyBudgetWarning     Boolean @default(true)
  notifyBudgetExceeded    Boolean @default(true)
  notifyUpcomingRecurring Boolean @default(true)
  notifySavingGoalReminder Boolean @default(true)
  notifySubscriptionReminder Boolean @default(true)
  notifyFinancialInsight  Boolean @default(true)
  notifyMonthlyReport     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_settings")
}

enum AccountType {
  CASH
  BANK
  MOBILE_WALLET
  CREDIT_CARD
  SAVINGS
  OTHER
}

enum AccountStatus {
  ACTIVE
  ARCHIVED
}

/// "Financial accounts" (§11) — named FinancialAccount / financial_accounts
/// to avoid colliding with Better Auth's own `account` (OAuth) table.
model FinancialAccount {
  id       String        @id @default(cuid())
  userId   String
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name     String
  type     AccountType
  balance  Decimal       @default(0) @db.Decimal(14, 2)
  currency String        @default("BDT")
  status   AccountStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions       Transaction[]            @relation("AccountTransactions")
  transfersFrom      Transaction[]            @relation("TransferFromAccount")
  transfersTo        Transaction[]            @relation("TransferToAccount")
  recurringTransactions RecurringTransaction[]
  subscriptions      Subscription[]

  @@index([userId])
  @@map("financial_accounts")
}

enum CategoryType {
  INCOME
  EXPENSE
}

enum CategoryStatus {
  ACTIVE
  ARCHIVED
}

/// Global defaults have userId = null; user-created categories have userId set.
model Category {
  id          String         @id @default(cuid())
  userId      String?
  user        User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  icon        String?
  description String?
  type        CategoryType
  status      CategoryStatus @default(ACTIVE)
  isDefault   Boolean        @default(false)

  parentCategoryId String?
  parentCategory    Category?  @relation("CategoryHierarchy", fields: [parentCategoryId], references: [id], onDelete: SetNull)
  subCategories     Category[] @relation("CategoryHierarchy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions          Transaction[]
  budgets               Budget[]
  recurringTransactions RecurringTransaction[]
  subscriptions         Subscription[]

  @@index([userId])
  @@map("categories")
}

model Tag {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name   String
  color  String?

  createdAt DateTime @default(now())

  transactionTags TransactionTag[]

  @@unique([userId, name])
  @@map("tags")
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum PaymentMethod {
  CASH
  BANK
  CARD
  MOBILE_WALLET
  OTHER
}

/// Centralized transaction table (§12) covering income, expense and transfer.
model Transaction {
  id     String           @id @default(cuid())
  userId String
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type   TransactionType

  amount   Decimal @db.Decimal(14, 2)
  currency String  @default("BDT")

  // Income / Expense use `account`; Transfer uses fromAccount/toAccount instead.
  accountId String?
  account   FinancialAccount? @relation("AccountTransactions", fields: [accountId], references: [id], onDelete: SetNull)

  fromAccountId String?
  fromAccount   FinancialAccount? @relation("TransferFromAccount", fields: [fromAccountId], references: [id], onDelete: SetNull)
  toAccountId   String?
  toAccount     FinancialAccount? @relation("TransferToAccount", fields: [toAccountId], references: [id], onDelete: SetNull)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  date          DateTime
  paymentMethod PaymentMethod?
  source        String? // income source, e.g. "Company XYZ" (§9)
  note          String?
  location      String?

  isRecurring          Boolean @default(false)
  recurringTransactionId String?
  recurringTransaction  RecurringTransaction? @relation(fields: [recurringTransactionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tags     TransactionTag[]
  receipts Receipt[]

  @@index([userId, date])
  @@index([userId, type])
  @@index([userId, categoryId])
  @@map("transactions")
}

model TransactionTag {
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  tagId         String
  tag           Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([transactionId, tagId])
  @@map("transaction_tags")
}

/// One active monthly budget per category per user (§13).
model Budget {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  amount Decimal @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, categoryId])
  @@map("budgets")
}

enum SavingGoalStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

model SavingGoal {
  id            String           @id @default(cuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  icon          String?
  targetAmount  Decimal          @db.Decimal(14, 2)
  currentAmount Decimal          @default(0) @db.Decimal(14, 2)
  targetDate    DateTime?
  status        SavingGoalStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contributions SavingGoalContribution[]

  @@index([userId])
  @@map("saving_goals")
}

/// Contribution history, used to compute "current saving rate" (§14).
model SavingGoalContribution {
  id           String     @id @default(cuid())
  savingGoalId String
  savingGoal   SavingGoal @relation(fields: [savingGoalId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount       Decimal    @db.Decimal(14, 2)
  date         DateTime   @default(now())
  note         String?

  @@index([savingGoalId])
  @@map("saving_goal_contributions")
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
}

model Subscription {
  id     String             @id @default(cuid())
  userId String
  user   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name   String
  amount Decimal            @db.Decimal(14, 2)

  billingCycle    BillingCycle
  nextBillingDate DateTime
  status          SubscriptionStatus @default(ACTIVE)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  accountId  String?
  account    FinancialAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("subscriptions")
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
  CUSTOM
}

enum RecurringStatus {
  ACTIVE
  PAUSED
  ENDED
}

model RecurringTransaction {
  id     String           @id @default(cuid())
  userId String
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type   TransactionType

  amount     Decimal @db.Decimal(14, 2)
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  accountId  String?
  account    FinancialAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  frequency     RecurrenceFrequency
  customInterval Int?     // days, only used when frequency = CUSTOM
  startDate     DateTime
  endDate       DateTime?
  nextRunDate   DateTime
  status        RecurringStatus @default(ACTIVE)

  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  generatedTransactions Transaction[]

  @@index([userId, nextRunDate])
  @@map("recurring_transactions")
}

enum NotificationType {
  BUDGET_WARNING
  BUDGET_EXCEEDED
  UPCOMING_RECURRING
  SAVING_GOAL_REMINDER
  SUBSCRIPTION_REMINDER
  FINANCIAL_INSIGHT
  MONTHLY_REPORT_AVAILABLE
}

model Notification {
  id      String            @id @default(cuid())
  userId  String
  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type    NotificationType
  title   String
  message String
  isRead  Boolean           @default(false)
  metadata Json?

  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@map("notifications")
}

model Receipt {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactionId String?
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  fileName String
  fileUrl  String
  mimeType String
  fileSize Int

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("receipts")
}

enum InsightSeverity {
  POSITIVE
  WARNING
  CRITICAL
}

model FinancialInsight {
  id          String          @id @default(cuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  severity    InsightSeverity
  title       String
  message     String
  category    String?
  metadata    Json?
  isDismissed Boolean         @default(false)

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("financial_insights")
}
