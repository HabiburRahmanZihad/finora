  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "dotenv": "^16.4.7",
    "prisma": "7.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
