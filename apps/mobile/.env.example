# For a physical device/simulator, replace localhost with your machine's LAN
# IP (e.g. http://192.168.1.20:3000) — a phone can't reach your computer's
# "localhost". The Android emulator alone can use http://10.0.2.2:3000.
EXPO_PUBLIC_AUTH_URL="http://localhost:3000"
EXPO_PUBLIC_API_URL="http://localhost:4000"
