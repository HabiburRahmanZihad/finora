# Finora — environment variable reference (production).
#
# Vercel and Render take env vars through their own project dashboards, not
# from a committed file — this file just documents what to set where, so
# nothing gets copy-pasted wrong or forgotten. See README.md → "Deployment".
#
# One rule that trips people up: BETTER_AUTH_URL, WEB_APP_URL and the
# frontend's own deployed URL must all be the SAME value (your Vercel URL,
# or a custom domain pointed at it) — Better Auth signs its JWTs with that
# URL as both issuer and audience, and the API checks against it exactly.

# ── apps/client on Vercel ───────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"          # same Neon project (or a prod branch)
BETTER_AUTH_SECRET="generate-a-new-long-random-string-for-prod"             # different from your dev secret
BETTER_AUTH_URL="https://your-app.vercel.app"                              # your real Vercel URL / custom domain
NEXT_PUBLIC_API_URL="https://your-api.onrender.com"                        # your Render service URL
GOOGLE_CLIENT_ID=""                                                        # optional
GOOGLE_CLIENT_SECRET=""                                                    # optional
SMTP_HOST="smtp.gmail.com"                                                 # required — powers password-reset emails
SMTP_PORT="587"                                                            # see apps/client/.env.production.example
SMTP_USER="your-address@gmail.com"
SMTP_PASS="your-16-char-app-password"
EMAIL_FROM="Finora <your-address@gmail.com>"

# ── apps/server on Render ───────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"          # same value as above
WEB_APP_URL="https://your-app.vercel.app"                                  # must match BETTER_AUTH_URL above exactly
BETTER_AUTH_URL="https://your-app.vercel.app"                              # must match BETTER_AUTH_URL above exactly
# PORT is injected automatically by Render — do not set it yourself.
